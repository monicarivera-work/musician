{
  "name": "musician",
  "version": "0.1.0",
  "private": true,
  "description": "A phone app for learning music from real songs and from your own voice.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p . && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/besley": "^5.3.0",
    "pitchy": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tonal": "^6.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
